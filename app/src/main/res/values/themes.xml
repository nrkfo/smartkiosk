<resources>

    <!-- Base Leanback theme for TV Leanback components -->
    <style name="Theme.SmartKiosk" parent="@style/Theme.Leanback" />

    <!-- AppCompat theme required for AppCompatActivity -->
    <style name="Theme.SmartKiosk.Kiosk" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
