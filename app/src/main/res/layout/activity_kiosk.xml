<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_kiosk_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- WebView for HTML5 / Web Kiosk Mode -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- PlayerView for Digital Signage Media Mode -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:focusable="false" />

    <!-- Offline / Network Error Overlay -->
    <LinearLayout
        android:id="@+id/offline_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Нет подключения к сети"
            android:textColor="#FF5252"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offline_sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Пожалуйста, проверьте подключение Wi-Fi / Ethernet на Smart TV."
            android:textColor="#E0E0E0"
            android:textSize="18sp" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btn_retry_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:focusable="true"
            android:text="Повторить подключение" />
    </LinearLayout>

</FrameLayout>
