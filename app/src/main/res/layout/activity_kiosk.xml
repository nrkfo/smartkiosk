<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_kiosk_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- WebView for HTML5 / Web Kiosk Mode -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- PlayerView for Digital Signage Media Mode -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Offline / Network Error Overlay -->
    <LinearLayout
        android:id="@+id/offline_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0E"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tv_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Нет подключения к сети"
                android:textColor="#FF5252"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offline_sub_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Пожалуйста, проверьте подключение Wi-Fi / Ethernet на вашем Smart TV."
                android:textColor="#D4D4D8"
                android:textSize="18sp" />

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="32dp" />

            <Button
                android:id="@+id/btn_retry_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_tv_button_primary"
                android:focusable="true"
                android:paddingHorizontal="40dp"
                android:paddingVertical="14dp"
                android:text="🔄 Повторить подключение"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
